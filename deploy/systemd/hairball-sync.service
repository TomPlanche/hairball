# Hourly sync: incremental, then the calendar export.
# Started by hairball-sync.timer. See "Deployment" in the README.

[Unit]
Description=hairball: incremental sync and calendar export
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=hairball
Group=hairball
# The database lives here (`database = "/var/lib/hairball/hairball.db"`).
StateDirectory=hairball
# No `.env` here: the CLI must not find one by accident.
WorkingDirectory=/var/lib/hairball
# The secrets (GITHUB_TOKEN, LASTFM_API_KEY, BSKY_APP_PASSWORD). Mode 0600.
EnvironmentFile=/etc/hairball/secrets.env
# The lock makes the hourly and the nightly sync wait for each other:
# they write to the same SQLite file.
ExecStart=/usr/bin/flock /run/lock/hairball.lock /usr/local/bin/hairball --config /etc/hairball/config.toml sync
# After the sync, even if a source failed: the other sources have new data.
ExecStopPost=/usr/local/bin/hairball --config /etc/hairball/config.toml export --out /srv/hairball/calendar.json

# Sandbox: the service reads its config, writes its state and the export.
ReadWritePaths=/srv/hairball /run/lock
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
